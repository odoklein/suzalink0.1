# Copy to .env.local. Everything is optional in local dev: the site falls back
# to safe defaults and shows placeholders where a service is missing.

# Domains
NEXT_PUBLIC_SITE_URL=https://suzalink.com
NEXT_PUBLIC_APP_URL=https://app.suzalink.com

# Cal.com booking (demo during signup, /demo, /sur-mesure). Event slugs like "suzalink/demo".
# Use https://app.cal.eu for the EU instance.
NEXT_PUBLIC_CAL_ORIGIN=https://app.cal.com
NEXT_PUBLIC_CAL_DEMO_LINK=
NEXT_PUBLIC_CAL_EXPERT_LINK=

# Leads API into Suzalink's own workspace (PRD dependency #14). Server only.
LEADS_API_URL=
LEADS_API_TOKEN=

# Cloudflare Turnstile on the forms. Without the secret, verification is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics (PostHog EU, memory-only until consent) and the LinkedIn Insight tag (after consent).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Unverified claims are hidden or shown as « Bientôt » in strict mode.
# Strict is automatic on Vercel production; set to 1 to preview it locally.
SITE_STRICT_CLAIMS=
